# ---------------------------------------------------------------------------
# Waslu backend — example environment
#
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
#
# Every variable the application reads is listed here. The placeholders below are
# safe for LOCAL DEVELOPMENT ONLY. Never use them in staging or production, and
# never commit a real `.env` (it is gitignored).
#
# Adding a new variable? See "Environment variables" in CONTRIBUTING.md.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------

# Which environment we are running in. Medusa uses this to pick behaviour and to
# load the matching .env file. One of: development | test | production.
# Default: development
NODE_ENV=development

# Port the Medusa HTTP server listens on. The admin dashboard is served from the
# same port at /admin. Default: 9000
PORT=9000

# --- PostgreSQL ------------------------------------------------------------

# Connection string the application uses. Format:
#   postgres://USER:PASSWORD@HOST:PORT/DATABASE
#
# Use `localhost` when running `npm run dev` on your own machine.
# Use the Compose service name `postgres` when running inside Docker — the app
# container cannot reach the host's `localhost`. docker-compose.yml sets this for
# you, so you normally only need the localhost value here.
# REQUIRED. Startup fails if this is missing.
DATABASE_URL=postgres://waslu:waslu_dev_only@localhost:5432/waslu

# These three are read by docker-compose.yml to initialise the PostgreSQL
# container. They are NOT read by the application itself. They must agree with
# the user / password / database in DATABASE_URL above.
# Development placeholders only — change them for any shared environment.
POSTGRES_USER=waslu
POSTGRES_PASSWORD=waslu_dev_only
POSTGRES_DB=waslu

# --- Redis -----------------------------------------------------------------

# Connection string for Redis, used by Medusa's event bus, workflow engine and
# cache. Format: redis://[:PASSWORD@]HOST:PORT
#
# Use `localhost` for `npm run dev`, and the Compose service name `redis` inside
# Docker (docker-compose.yml overrides this).
# REQUIRED. Startup fails if this is missing.
REDIS_URL=redis://localhost:6379

# --- Secrets ---------------------------------------------------------------

# Signs seller/customer/admin JWTs. REQUIRED.
# Must be a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production this must be at least 32 characters and must not be the
# placeholder below — startup refuses to boot otherwise.
JWT_SECRET=dev-only-jwt-secret-change-me

# Signs the session cookie. Same rules and generation command as JWT_SECRET.
# Use a DIFFERENT value from JWT_SECRET. REQUIRED.
COOKIE_SECRET=dev-only-cookie-secret-change-me

# --- CORS ------------------------------------------------------------------
# Comma-separated lists of browser origins allowed to call each API surface.
# No trailing slash, no spaces, no wildcard `*` (credentials would break).
# All three are REQUIRED; startup fails if any is missing.

# Origins allowed to call the public storefront API (/store).
# Point this at your storefront dev server.
STORE_CORS=http://localhost:8000

# Origins allowed to call the platform admin API (/admin).
# 9000 is the bundled Medusa admin dashboard served by this backend.
ADMIN_CORS=http://localhost:9000

# Origins allowed to call the authentication API (/auth).
# Include every origin that logs sellers, customers or admins in.
AUTH_CORS=http://localhost:8000,http://localhost:9000